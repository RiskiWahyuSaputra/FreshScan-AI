# FreshScan AI Environment Configuration

# 1. Groq API Key (Dapatkan secara gratis dari https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Groq Vision Model (Model yang mendukung pemrosesan gambar multimodal)
# Rekomendasi terkini: qwen/qwen3.8-27b (27B multimodal vision dengan json mode)
# Alternatif: meta-llama/llama-3.2-11b-vision-preview (jika tersedia di tier akun Anda)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
